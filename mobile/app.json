{
  "expo": {
    "name": "Duara",
    "slug": "duara",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1C1C"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1C1C"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "SEND_SMS",
        "READ_SMS"
      ],
      "package": "com.duara.app"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.duara.app"
    },
    "updates": {
      "url": "https://u.expo.dev/9246ff32-9bc9-4291-bdbc-d601a5b86145",
      "enabled": true,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "9246ff32-9bc9-4291-bdbc-d601a5b86145"
      }
    },
    "scheme": "duara",
    "owner": "jocularjohny",
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Duara needs your location to include it in SOS alerts.",
          "locationWhenInUsePermission": "Duara needs your location to include it in SOS alerts."
        }
      ]
    ]
  }
}
